{
  "name": "namedrop-channels-experiment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none src/*.test.ts",
    "test:browser": "npm run build && node --test test/browser.test.mjs",
    "test:live-peek": "npm run build && node --test test/live-peek.browser.mjs",
    "build": "vite build",
    "bundle": "npm run build && node bundle.mjs",
    "bundle:check": "npm run build && node bundle.mjs --check",
    "test:blank-paint": "npm run build && node --test --test-name-pattern=\"recorded native 736/737|blank presentation\" test/blank-paint.browser.mjs"
  },
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
